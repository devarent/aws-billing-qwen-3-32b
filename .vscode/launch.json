{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/laragon/www/aws billing qween 3 32b",
      "program": "c:/laragon/www/aws billing qween 3 32b/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures: true
        }
      ]
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe"
    },
    {
      "name": "Python: Chat Groq",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/chat_groq.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe"
    },
    {
      "name": "Python: Chat OpenRouter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/chat_openrouter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe"
    },
    {
      "name": "Python: Chat Bedrock",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/chat_bedrock.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/Scripts/python.exe"
    }
  ]
}
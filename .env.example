# ========================================================
# Konfigurasi Kredensial Multi-Provider
# Salin file ini menjadi .env lalu isi nilai-nilainya
# ========================================================

# -------------------------
# Groq Configuration
# Dapatkan gratis di https://console.groq.com/keys
# -------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen-2.5-coder-32b-instruct

# -------------------------
# OpenRouter Configuration
# Dapatkan di https://openrouter.ai/keys
# Mendukung Qwen 2.5 32B, 72B, QwQ, dll
# -------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -------------------------
# Google Cloud / Gemini Configuration
# Dapatkan di https://aistudio.google.com/app/apikey
# Atau via GCP Vertex AI
# -------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------
# AWS Configuration
# Dipakai untuk Amazon Bedrock DAN AWS Billing Manager:
# - STS GetCallerIdentity
# - Cost Explorer GetCostAndUsage
# - AWS Budgets DescribeBudgets
#
# Buat IAM user read-only khusus billing (jangan pakai root key).
# Panduan: docs/AWS_BILLING_SETUP.md
# -------------------------
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
# Opsional untuk temporary credential (AWS SSO / STS)
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Rentang default tombol "Sinkron dari AWS"
AWS_SYNC_DAYS=30
BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b

# -------------------------
# Google Cloud Project Configuration
# Opsional untuk Budget Guard GCP
# -------------------------
GCP_PROJECT_ID=your-gcp-project-id

# -------------------------
# AWS Billing Manager (MySQL)
# Modul /billing/ memakai container MySQL terpisah.
# -------------------------
DB_NAME=aws_billing
DB_USER=qween
DB_PASSWORD=qween_secret
DB_ROOT_PASSWORD=qween_root_secret

# -------------------------
# Runtime Configuration
# -------------------------
# PHP timezone
TZ=Asia/Jakarta

# Debug mode (true/false)
DEBUG=false

# -------------------------
# Redis / Budget Enforcement
# -------------------------
# Budget enforcement bersifat fail-open:
# jika Redis tidak tersedia, request tetap diizinkan.
BUDGET_ENFORCEMENT_ENABLED=false
DEFAULT_DAILY_CAP=10.0
DEFAULT_MONTHLY_CAP=100.0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TIMEOUT=1.5
